#!/bin/bash
set -euo pipefail

# mucli TB agent install {{ version }}: dependencies + source into /opt/mucli.
mkdir -p /opt/mucli
apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git python3-pip

export PIP_BREAK_SYSTEM_PACKAGES=1
pip_install() {
    local attempt
    for attempt in 1 2; do
        if python3 -m pip install --retries 3 --quiet --no-input "$@"; then
            return 0
        fi
        echo "pip install attempt ${attempt}/2 failed" >&2
    done
    echo "pip install failed after 2 attempts: $*" >&2
    return 1
}

if [ ! -f /mucli-src/mucli.py ] || [ ! -f /mucli-src/requirements.txt ]; then
    echo "MUCLI_SOURCE_MISSING: /mucli-src must contain mucli.py and requirements.txt" >&2
    exit 1
fi

# Fast path: pre-baked offline wheelhouse (no network, ~5s).
# Slow path: network install with retries (only when payload missing).
if [ -f /tmp/mucli-wheelhouse.tar.gz ]; then
    mkdir -p /mucli-wheelhouse
    tar -xzf /tmp/mucli-wheelhouse.tar.gz -C /mucli-wheelhouse
    python3 -m pip install --quiet --no-input --no-index \
        --find-links /mucli-wheelhouse/wheelhouse \
        -r /mucli-src/requirements.txt \
        pathspec python-dotenv psutil
    echo "mucli deps installed from offline wheelhouse"
else
    echo "NO_WHEELHOUSE: falling back to network install" >&2
    pip_install -r /mucli-src/requirements.txt
    pip_install "pathspec" "python-dotenv" "psutil"
fi

cp -r /mucli-src/. /opt/mucli/
cd /opt/mucli
# mucli wheel is in the wheelhouse too; no network needed.
if [ -f /mucli-wheelhouse/wheelhouse/mucli-*.whl ] 2>/dev/null || \
   ls /mucli-wheelhouse/wheelhouse/mucli-*.whl >/dev/null 2>&1; then
    python3 -m pip install --quiet --no-index \
        --find-links /mucli-wheelhouse/wheelhouse \
        /mucli-wheelhouse/wheelhouse/mucli-*.whl
else
    pip_install -e . --no-deps
fi
cat > /usr/local/bin/mucli <<'EOF'
#!/bin/sh
exec python3 /opt/mucli/mucli.py "$@"
EOF
chmod +x /usr/local/bin/mucli

cat > /usr/local/bin/mucli-bench-wrapper <<'EOF'
#!/bin/bash
# Non-interactive one-shot run: send the instruction, wait for completion.
cd "$MUCLI_WORKING_DIR"
mucli --session "tb-$$" --headless "$MUCLI_TASK_INSTRUCTION"
EOF
chmod +x /usr/local/bin/mucli-bench-wrapper

python3 -c '
import importlib
import sys

modules = (
    "rich",
    "tiktoken",
    "pathspec",
    "google.genai",
    "fastapi",
    "uvicorn",
    "httpx",
    "dotenv",
    "psutil",
    "openai",
)
failed = False
for module in modules:
    try:
        importlib.import_module(module)
    except Exception as exc:
        failed = True
        print(f"MUCLI_VERIFY_IMPORT_FAILED: {module}: {exc}", file=sys.stderr)
if failed:
    raise SystemExit(1)
'

mucli --help >/dev/null 2>&1 || exit 1
echo "mucli install OK"
